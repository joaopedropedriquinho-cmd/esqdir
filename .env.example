PORT=3000
TIKTOK_USERNAME=quiz_azul
# Optional: IDs copied from real [GIFT] diagnostics; leave empty until confirmed.
TIKTOK_RED_ROSE_GIFT_IDS=
TIKTOK_WHITE_ROSE_GIFT_IDS=

# On Render, mount a persistent disk at /var/data and use this path.
SCORE_FILE=./data/score.json

# Required when the signing provider account requires a Business plan.
# Set a valid Euler Stream API key; never commit the secret.
TIKTOK_SIGN_API_KEY=